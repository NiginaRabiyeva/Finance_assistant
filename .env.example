# Скопируйте этот файл в .env и поправьте значения
SECRET_KEY=change-me
# MySQL (основной вариант):
DATABASE_URL=mysql+pymysql://finance_user:finance_pass@127.0.0.1:3306/finance_db
# Если MySQL пока нет - раскомментируйте SQLite, всё заработает сразу:
# DATABASE_URL=sqlite:///finance.db
# AI-бот: без ключа работает встроенный бот-аналитик, с ключом - Claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
